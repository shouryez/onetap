# ---- LLM provider: any OpenAI-compatible endpoint ----
# Groq (default, free tier works): https://console.groq.com/keys
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
# Per-stage models (defaults shown)
# LLM_MODEL=openai/gpt-oss-120b
# LLM_ENRICH_MODEL=qwen/qwen3.8-27b
# LLM_FAST_MODEL=openai/gpt-oss-20b
# LLM_REPAIR_MODEL=qwen/qwen3.8-27b

# Gemini alternative:
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=<gemini key>
# LLM_MODEL=gemini-2.5-flash
# LLM_ENRICH_MODEL=gemini-2.5-flash-lite
# LLM_FAST_MODEL=gemini-2.5-flash-lite
# LLM_REPAIR_MODEL=gemini-2.5-flash-lite
# LLM_MODEL_POOL=gemini-2.5-flash,gemini-2.5-flash-lite
